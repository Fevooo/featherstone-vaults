---
/**
 * Plate — the reserved image position in the catalogue.
 *
 * Sale-object plates remain blank until Featherstone Vaults has real object
 * photography. Department plates may also use explicitly credited open-access
 * museum imagery to give the site visual context without implying ownership.
 *
 * Remote department imagery is routed through Netlify Image CDN. This removes
 * third-party connection/redirect latency for visitors, resizes to the actual
 * rendered plate, negotiates a modern image format and caches the result at the
 * edge.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Aspect ratio as width/height, e.g. '2 / 3' for a portrait panel. */
  ratio?: string;
  /** Plate tone, 1–4, giving the catalogue a quiet tonal rhythm. */
  tone?: '1' | '2' | '3' | '4';
  image?: ImageMetadata | string;
  alt?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  ratio = '3 / 4',
  tone = '1',
  image,
  alt = '',
  sizes,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const isRemote = typeof image === 'string';
const fetchPriority = loading === 'eager' ? 'high' : 'low';

function ratioHeight(width: number) {
  const [rw, rh] = ratio.split('/').map((part) => Number(part.trim()));
  if (!Number.isFinite(rw) || !Number.isFinite(rh) || rw <= 0 || rh <= 0) return undefined;
  return Math.round((width * rh) / rw);
}

function netlifyImage(source: string, width: number) {
  const params = new URLSearchParams({
    url: source,
    w: String(width),
    q: '76',
    fit: 'cover',
  });
  const height = ratioHeight(width);
  if (height) params.set('h', String(height));
  return `/.netlify/images?${params.toString()}`;
}

const remoteWidths = [320, 480, 640, 800, 1200, 1600];
const remoteSrc = isRemote ? netlifyImage(image, 800) : undefined;
const remoteSrcSet = isRemote
  ? remoteWidths.map((width) => `${netlifyImage(image, width)} ${width}w`).join(', ')
  : undefined;
---

<div
  class:list={['plate', className]}
  style={`aspect-ratio:${ratio};background-color:var(--color-plate-${tone})`}
>
  {
    image ? (
      isRemote ? (
        <img
          src={remoteSrc}
          srcset={remoteSrcSet}
          alt={alt}
          sizes={sizes}
          loading={loading}
          fetchpriority={fetchPriority}
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <Image
          src={image}
          alt={alt}
          sizes={sizes}
          loading={loading}
          fetchpriority={fetchPriority}
          widths={[320, 480, 640, 800, 1200, 1600]}
          quality={76}
          class="h-full w-full object-cover"
        />
      )
    ) : (
      <span
        class="pointer-events-none absolute inset-[5.5%] block border border-[var(--line-soft)]"
        aria-hidden="true"
      />
    )
  }
</div>
