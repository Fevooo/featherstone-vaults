---
/**
 * Plate — the reserved image position in the catalogue.
 *
 * Sale-object plates remain blank until Featherstone Vaults has real object
 * photography. Department plates may also use explicitly credited open-access
 * museum imagery to give the site visual context without implying ownership.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Aspect ratio as width/height, e.g. '2 / 3' for a portrait panel. */
  ratio?: string;
  /** Plate tone, 1–4, giving the catalogue a quiet tonal rhythm. */
  tone?: '1' | '2' | '3' | '4';
  image?: ImageMetadata | string;
  alt?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  ratio = '3 / 4',
  tone = '1',
  image,
  alt = '',
  sizes,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const isRemote = typeof image === 'string';
const fetchPriority = loading === 'eager' ? 'high' : 'low';

function commonsSrcSet(source?: string) {
  if (!source) return undefined;

  try {
    const url = new URL(source);
    const canResize =
      url.hostname === 'commons.wikimedia.org' &&
      url.searchParams.has('width') &&
      (url.pathname.includes('/Special:FilePath/') || url.pathname.includes('/Special:Redirect/file/'));

    if (!canResize) return undefined;

    const requestedMax = Number(url.searchParams.get('width')) || 1600;
    const widths = [320, 480, 640, 800, 1200, 1600]
      .filter((width) => width <= requestedMax)
      .concat(requestedMax)
      .filter((width, index, values) => values.indexOf(width) === index)
      .sort((a, b) => a - b);

    return widths
      .map((width) => {
        const candidate = new URL(url);
        candidate.searchParams.set('width', String(width));
        return `${candidate.toString()} ${width}w`;
      })
      .join(', ');
  } catch {
    return undefined;
  }
}

const remoteSrcSet = isRemote ? commonsSrcSet(image) : undefined;
---

<div
  class:list={['plate', className]}
  style={`aspect-ratio:${ratio};background-color:var(--color-plate-${tone})`}
>
  {
    image ? (
      isRemote ? (
        <img
          src={image}
          srcset={remoteSrcSet}
          alt={alt}
          sizes={sizes}
          loading={loading}
          fetchpriority={fetchPriority}
          decoding="async"
          referrerpolicy="no-referrer"
          class="h-full w-full object-cover"
        />
      ) : (
        <Image
          src={image}
          alt={alt}
          sizes={sizes}
          loading={loading}
          fetchpriority={fetchPriority}
          widths={[480, 800, 1200, 1800]}
          class="h-full w-full object-cover"
        />
      )
    ) : (
      <span
        class="pointer-events-none absolute inset-[5.5%] block border border-[var(--line-soft)]"
        aria-hidden="true"
      />
    )
  }
</div>
