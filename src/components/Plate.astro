---
/**
 * Plate — the reserved image position in the catalogue.
 *
 * Featherstone Vaults photography has not been supplied. Rather than
 * illustrate the catalogue with pictures of objects the house does not hold,
 * each image position renders a flat tonal field inside a hairline mount, with
 * a small caption. Nothing here depicts an object, and nothing is implied.
 *
 * Pass `image` and the plate is replaced by the photograph.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Aspect ratio as width/height, e.g. '2 / 3' for a portrait panel. */
  ratio?: string;
  /** Plate tone, 1–4, giving the catalogue a quiet tonal rhythm. */
  tone?: '1' | '2' | '3' | '4';
  image?: ImageMetadata;
  alt?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  ratio = '3 / 4',
  tone = '1',
  image,
  alt = '',
  sizes,
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['plate', className]}
  style={`aspect-ratio:${ratio};background-color:var(--color-plate-${tone})`}
>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        sizes={sizes}
        loading={loading}
        widths={[480, 800, 1200, 1800]}
        class="h-full w-full object-cover"
      />
    ) : (
      <span
        class="pointer-events-none absolute inset-[5.5%] block border border-[var(--line-soft)]"
        aria-hidden="true"
      />
    )
  }
</div>
