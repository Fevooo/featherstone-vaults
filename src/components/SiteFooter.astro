---
import { FOOTER_NAV, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="mt-auto rule-t bg-charcoal">
  <div class="shell py-16 lg:py-24">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-20">
      <div>
        <img
          src="/brand/lockup-ivory.svg"
          alt={`${SITE.name}. ${SITE.strapline}`}
          width="240"
          height="119"
          loading="lazy"
          class="w-[14rem]"
        />
        <p class="meta mt-8 max-w-[20rem] text-ash">
          A private dealer and collection house for historically, scientifically and culturally
          significant objects.
        </p>
        <a href="/enquire" class="action-quiet mt-8">Make an enquiry</a>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 sm:gap-8">
        {
          FOOTER_NAV.map((group) => (
            <nav aria-label={group.heading}>
              <h2 class="label-sm text-bronze-lit">{group.heading}</h2>
              <ul class="mt-5 space-y-2.5">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="meta text-parchment transition-colors hover:text-ivory"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-5 rule-t pt-8 lg:mt-20 lg:flex-row lg:items-baseline lg:justify-between"
    >
      <p class="label-sm text-ash">
        {SITE.name}<span class="mx-2.5 text-ash/60" aria-hidden="true">·</span>{SITE.locality}
        <span class="mx-2.5 text-ash/60" aria-hidden="true">·</span>{SITE.country}
      </p>
      <p class="label-sm text-ash">
        <a href={SITE.url} class="transition-colors hover:text-parchment"
          >featherstonevaults.com</a
        >
        <span class="mx-2.5 text-ash/60" aria-hidden="true">·</span>
        <span class="tnum">© {year}</span>
      </p>
    </div>
  </div>
</footer>
