---
import Plate from './Plate.astro';
import type { DepartmentEntry } from '../lib/catalogue';

interface Props {
  department: DepartmentEntry;
  index: number;
  ratio?: string;
  sizes?: string;
}
const { department, index, ratio = '2 / 3', sizes } = Astro.props;
const { title, shortTitle, keywords, plateTone, image, imageAlt } = department.data;
const number = String(index).padStart(2, '0');
---

<article class="stretch-host group relative">
  <a href={`/collections/${department.id}`} class="stretch block focus:outline-none">
    <span class="sr-only">{title}</span>
  </a>

  <Plate
    ratio={ratio}
    tone={plateTone}
    image={image}
    alt={imageAlt ?? ''}
    sizes={sizes}
    class="transition-[filter] duration-500 group-hover:brightness-[1.4]"
  />

  <div class="relative mt-5">
    <span
      class="block h-px w-9 bg-bronze transition-[width] duration-500 ease-out group-hover:w-full"
    ></span>
    <div class="mt-4 flex items-baseline gap-3">
      <span class="label-sm tnum shrink-0 text-ash">{number}</span>
      <h3
        class="display-3 min-h-[2.44em] text-parchment transition-colors duration-300 group-hover:text-ivory"
      >
        {shortTitle ?? title}
      </h3>
    </div>
    <p class="label-sm mt-3 text-ash">
      {keywords.join(' · ')}
    </p>
  </div>
</article>
